{
	local_certs
}

northwind.mytest.run {
	tls internal
	reverse_proxy localhost:3000
}

payments.mytestrun.com {
	tls internal

	# Auth.js callback — must be first to prevent /api/* catching it
	handle /api/auth/* {
		reverse_proxy localhost:3001
	}

	# payment-admin-web (basePath: /admin) — match bare /admin and /admin/*
	handle /admin* {
		reverse_proxy localhost:3002
	}

	# payment-api (all routes already at /api/*)
	handle /api/* {
		reverse_proxy localhost:3003
	}

	# chatbot-agent (basePath: /chatbot — no prefix strip) — match bare /chatbot and /chatbot/*
	handle /chatbot* {
		reverse_proxy localhost:3004
	}

	# payment-user-web fallthrough
	handle {
		reverse_proxy localhost:3001
	}
}
