# Acme Assist (chatbot-agent) environment variables.

# Merchant definition runtime (must match merchant-web deployment).
MERCHANT_ID=northwind
MERCHANT_CONFIG_DIR=/absolute/path/to/repository/config/merchants
#
# Copy this file to `.env.local` and fill in real values for local dev.

# LLM provider (chatbot). Env var names follow the canonical SDK convention.
# OPENAI_API_KEY is required — the /api/chat handler returns HTTP 500 if absent.
# Set this to a valid key in .env.local; never commit the real value.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Downstream services this app calls at runtime.
PAYMENT_API_BASE_URL=http://localhost:3003

# ── Step 1: merchant-token-login journey + session→token bridge ────────────
#
# Owned entirely by this app — never proxied through merchant-web. The widget
# (embed.js) obtains a one-time PKCE authorization code via its own
# silent-SSO popup and sends it here; this server exchanges that code for a
# merchant ID token itself (never the browser — the merchant IDP's token
# endpoint has no CORS headers for browser-originated requests, and this
# avoids requiring any tenant-wide CORS configuration on the merchant IDP),
# runs the merchant-token-login AM journey, then bridges the resulting AM
# session into a real access token.

# Merchant IDP (bravo realm) token endpoint and the public client + redirect
# used for the server-to-server PKCE code exchange. MERCHANT_BRIDGE_REDIRECT_URI
# must exactly match the widget's silent-callback.html URL (the value the
# browser used when starting the authorize request).
MERCHANT_IDP_TOKEN_URL=https://idc.scheuber.io/am/oauth2/realms/root/realms/bravo/access_token
MERCHANT_BRIDGE_CLIENT_ID=merchant-bridge
MERCHANT_BRIDGE_REDIRECT_URI=https://payments.mytestrun.com/chatbot/silent-callback.html

# AM deployment base URL (up to and including "/am"), used to build the
# /json/realms/.../authenticate, /json/serverinfo/*, and /oauth2/realms/.../authorize
# paths. Distinct from AIC_ALPHA_TOKEN_ENDPOINT below, which is the OAuth2
# token endpoint proper (shared with Step 2).
AIC_ALPHA_AM_BASE_URL=https://idc.scheuber.io/am

# Journey id in the alpha realm. Defaults to merchant-token-login if unset.
MERCHANT_TOKEN_LOGIN_JOURNEY_ID=merchant-token-login

# Confidential client credentials for the payment-bridge client (alpha realm),
# used only server-side to convert an AM session into an access token via the
# documented csrf/decision=allow session→token bridge pattern.
PAYMENT_BRIDGE_CLIENT_ID=payment-bridge
PAYMENT_BRIDGE_CLIENT_SECRET=replace-me
PAYMENT_BRIDGE_REDIRECT_URI=https://chatbot-agent.internal/callback/alpha-session-exchange

# AIC Northwind AI Agent OAuth2 client credentials (used for Step 2 token exchange).
# The old `chatbot-agent` client remains provisioned during migration; do not use
# its secret for this runtime.
CHATBOT_AGENT_CLIENT_ID=northwind-chatbot-agent
CHATBOT_AGENT_CLIENT_SECRET=replace-me

# AIC alpha realm token endpoint. Shared by the Step 1 session→token bridge
# (authorization_code grant, payment-bridge client) and Step 2 (token-exchange
# grant, northwind-chatbot-agent client) — same endpoint, different grants/clients.
AIC_ALPHA_TOKEN_ENDPOINT=https://idc.scheuber.io/am/oauth2/realms/root/realms/alpha/access_token

# AIC tenant base URL. Reserved for future runtime use — not currently read
# at runtime by chatbot-agent. The provisioner reads the tenant URL from
# config/payment/aic/inputs/tenant.json and authenticates via frodo connection profile.
AIC_TENANT_URL=https://idc.example.local

# Optional server-side operator/demo gate for raw caller-token diagnostics.
# Requires explicit per-request opt-in; payment service bearer tokens are never traced.
# AIC_ALLOW_RAW_TOKEN_TRACE=true
