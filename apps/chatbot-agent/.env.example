# Acme Assist (chatbot-agent) env variables — placeholder values only.
#
# Copy this file to `.env.local` and fill in real values for local dev. The
# scaffold does not read any of these at runtime — they are declared here so
# the follow-on wiring PRs have a single source of truth for what the app
# will need.

# LLM provider (chatbot). Env var names follow the canonical SDK convention.
# OPENAI_API_KEY is required — the /api/chat handler returns HTTP 500 if absent.
# Set this to a valid key in .env.local; never commit the real value.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Downstream services this app will call in follow-on PRs.
PAYMENT_API_BASE_URL=http://localhost:3003

# AIC chatbot-agent OAuth2 client credentials (used for Step 2 token exchange in Task 10).
CHATBOT_AGENT_CLIENT_ID=chatbot-agent
CHATBOT_AGENT_CLIENT_SECRET=replace-me

# AIC alpha realm token endpoint (used for token exchange in Tasks 9 and 10).
AIC_ALPHA_TOKEN_ENDPOINT=https://idc.scheuber.io/am/oauth2/realms/root/realms/alpha/access_token

# AIC IDM REST API base URL (used by alpha-token.ts for JIT user provisioning).
AIC_IDM_BASE_URL=https://idc.scheuber.io/openidm

# Payment-api OAuth2 client credentials for alpha realm token exchange (used by alpha-token.ts).
PAYMENT_API_CLIENT_ID=payment-api
PAYMENT_API_CLIENT_SECRET=replace-me

# Merchant IDP (bravo realm) OIDC configuration — used by /api/auth/* endpoints.
MERCHANT_OIDC_ISSUER=https://idc.scheuber.io/am/oauth2/realms/root/realms/bravo
MERCHANT_OIDC_CLIENT_ID=chatbot-agent
MERCHANT_OIDC_CLIENT_SECRET=replace-me
MERCHANT_OIDC_REDIRECT_URI=http://localhost:3004/api/auth/callback

# Payment-api MCP endpoint (used for MCP tool calls from the chatbot-agent).
PAYMENT_API_MCP_URL=http://localhost:3003/api/mcp

# AIC tenant + admin service account (used by config/aic/provision.ts).
AIC_TENANT_URL=https://idc.example.local
AIC_ADMIN_SVC_ACCOUNT_ID=replace-me
AIC_ADMIN_SVC_ACCOUNT_KEY=replace-me
