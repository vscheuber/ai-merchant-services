# Northwind Retail (merchant-web) env variables — placeholder values only.
#
# Copy this file to `.env.local` and fill in real values for local dev. The
# scaffold does not read any of these at runtime — they are declared here so
# the follow-on wiring PRs have a single source of truth for what the app
# will need.

# Merchant IDP (Northwind Retail authenticates against Acme Payments' `/bravo`
# realm in the follow-on Use Case 1 wiring PR).
MERCHANT_OIDC_ISSUER=https://idc.example.local/am/oauth2/realms/root/realms/bravo
MERCHANT_OIDC_CLIENT_ID=replace-me
MERCHANT_OIDC_CLIENT_SECRET=replace-me

# Downstream services this app will call in follow-on PRs (not the scaffold).
PAYMENT_API_BASE_URL=http://localhost:3003

# URL of the chatbot-agent overlay bundle. NEXT_PUBLIC_* is exposed to the
# browser bundle so the root layout's <script> tag can read it. The scaffold
# hard-codes the same value directly in `src/app/layout.tsx` for simplicity;
# consumers can swap the hard-coded URL for `process.env.NEXT_PUBLIC_CHATBOT_EMBED_URL`
# once the follow-on env-driven config wiring lands.
NEXT_PUBLIC_CHATBOT_EMBED_URL=http://localhost:3004/embed.js
