# Northwind Retail (merchant-web) env variables.
#
# Copy this file to `.env.local` and fill in real values for local dev.

# ── Auth.js v5 ──────────────────────────────────────────────────────────────

# Required by Auth.js to sign and encrypt session cookies.
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me

# ── AIC bravo realm (Merchant IDP) ──────────────────────────────────────────

# Issuer URL for the AIC bravo realm. Auth.js uses this to auto-discover the
# OIDC metadata endpoint (/.well-known/openid-configuration).
MERCHANT_OIDC_ISSUER=https://idc.scheuber.io/am/oauth2/realms/root/realms/bravo

# OAuth2 client provisioned in the bravo realm for this app.
MERCHANT_OIDC_CLIENT_ID=merchant-web
MERCHANT_OIDC_CLIENT_SECRET=replace-me

# ── Downstream services ──────────────────────────────────────────────────────

# Base URL for the payment-api.
PAYMENT_API_BASE_URL=http://localhost:3003

# ── Chatbot token proxy ──────────────────────────────────────────────────────

# OAuth2 client credentials for the payment-api client in the AIC alpha realm.
# Used by /api/chatbot/token to obtain a service-account token for IDM operations
# and to perform the Step 1 bravo→alpha token exchange.
PAYMENT_API_CLIENT_ID=payment-api
PAYMENT_API_CLIENT_SECRET=replace-me

# AIC alpha realm token endpoint — used for both client_credentials (service-account
# token for IDM) and the urn:ietf:params:oauth:grant-type:token-exchange grant (Step 1).
AIC_ALPHA_TOKEN_ENDPOINT=https://idc.scheuber.io/am/oauth2/realms/root/realms/alpha/access_token

# AIC IDM REST API base URL — used to query and JIT-provision managed/alpha_user objects.
AIC_IDM_BASE_URL=https://idc.scheuber.io/openidm

# Canonical merchant registry identifier used for payment-provider user metadata
# and the dynamic payment-provider group. Do not use the group name here.
PAYMENT_MERCHANT_ID=northwind
# Global payment-provider attribute names; defaults match the approved desired state.
PAYMENT_MERCHANT_ID_ATTRIBUTE=custom_merchantId
PAYMENT_MERCHANT_CUSTOMER_ID_ATTRIBUTE=custom_merchantCustomerId

# Hard write gate. Keep disabled until both payment-provider custom properties
# have an approved live schema and rollback plan.
# AIC_MERCHANT_SCHEMA_APPROVED=true

# ── Chatbot overlay ──────────────────────────────────────────────────────────

# URL of the chatbot-agent overlay bundle. NEXT_PUBLIC_* is exposed to the
# browser bundle so the root layout's <script> tag can read it at runtime.
# Falls back to http://localhost:3004/embed.js when not set.
NEXT_PUBLIC_CHATBOT_EMBED_URL=http://localhost:3004/embed.js
