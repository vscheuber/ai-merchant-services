# Northwind Retail (merchant-web) env variables.
#
# Copy this file to `.env.local` and fill in real values for local dev.

# ── Auth.js v5 ──────────────────────────────────────────────────────────────

# Required by Auth.js to sign and encrypt session cookies.
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me

# ── AIC bravo realm (Merchant IDP) ──────────────────────────────────────────

# Issuer URL for the AIC bravo realm. Auth.js uses this to auto-discover the
# OIDC metadata endpoint (/.well-known/openid-configuration).
MERCHANT_OIDC_ISSUER=https://idc.scheuber.io/am/oauth2/realms/root/realms/bravo

# OAuth2 client provisioned in the bravo realm for this app.
MERCHANT_OIDC_CLIENT_ID=merchant-web
MERCHANT_OIDC_CLIENT_SECRET=replace-me

# ── Downstream services ──────────────────────────────────────────────────────

# Base URL for the payment-api (used by Task 6 live data fetches).
PAYMENT_API_BASE_URL=http://localhost:3003

# ── Chatbot overlay ──────────────────────────────────────────────────────────

# URL of the chatbot-agent overlay bundle. NEXT_PUBLIC_* is exposed to the
# browser bundle so the root layout's <script> tag can read it at runtime.
# Falls back to http://localhost:3004/embed.js when not set.
NEXT_PUBLIC_CHATBOT_EMBED_URL=http://localhost:3004/embed.js
