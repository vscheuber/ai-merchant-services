# Acme Payments — payment API env variables (placeholder values only).
#
# Copy this file to `.env.local` and fill in real values for local dev. The
# scaffold does not read any of these at runtime — they are declared here so
# the follow-on wiring PRs have a single source of truth for what the API
# will need.

# Payment-side OIDC (AIC `/alpha` realm)
PAYMENT_OIDC_ISSUER=https://idc.example.local/am/oauth2/realms/root/realms/alpha
PAYMENT_OIDC_CLIENT_ID=payment-api-placeholder
PAYMENT_OIDC_CLIENT_SECRET=replace-me

# AIC tenant + admin service account (used by `config/aic/provision.ts`)
AIC_TENANT_URL=https://idc.example.local
AIC_ADMIN_SVC_ACCOUNT_ID=replace-me
AIC_ADMIN_SVC_ACCOUNT_KEY=replace-me
