# Acme Payments — payment API env variables (placeholder values only).
#
# Copy this file to `.env.local` and fill in real values for local dev.

# Payment-side OIDC (AIC `/alpha` realm)
PAYMENT_OIDC_ISSUER=https://idc.scheuber.io/am/oauth2/realms/root/realms/alpha
PAYMENT_OIDC_CLIENT_ID=payment-api
PAYMENT_OIDC_CLIENT_SECRET=replace-me

# JWKS URI used by the JWT middleware (Edge-compatible JWKS validation).
# Must match the alpha realm's public key endpoint.
PAYMENT_OIDC_JWKS_URI=https://idc.scheuber.io/am/oauth2/realms/root/realms/alpha/connect/jwk_uri

# AIC admin service account (used by `config/aic/provision.ts`).
# Note: the provisioner reads the tenant URL from config/aic/inputs/tenant.json,
# not from AIC_TENANT_URL. This var is reserved for future runtime use.
AIC_TENANT_URL=https://idc.scheuber.io
AIC_ADMIN_SVC_ACCOUNT_ID=replace-me
AIC_ADMIN_SVC_ACCOUNT_KEY=replace-me
