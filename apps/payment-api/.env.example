# Acme Payments — payment API env variables (placeholder values only).
#
# Copy this file to `.env.local` and fill in real values for local dev.

# Payment-side OIDC (AIC `/alpha` realm)
PAYMENT_OIDC_ISSUER=https://idc.scheuber.io/am/oauth2/realms/root/realms/alpha
PAYMENT_OIDC_CLIENT_ID=payment-api
PAYMENT_OIDC_CLIENT_SECRET=replace-me

# RFC 7662 token introspection endpoint, used by the auth middleware to
# validate Bearer tokens. Required because the alpha realm's OAuth2 Provider
# issues stateless access tokens signed with a symmetric algorithm (HS256),
# whose key is never published via JWKS (JWKS only ever carries asymmetric
# public keys) — introspection works regardless of signing algorithm.
PAYMENT_OIDC_INTROSPECTION_URL=https://idc.scheuber.io/am/oauth2/realms/root/realms/alpha/introspect

# JWKS URI. Not currently used by the middleware (see introspection above) —
# reserved in case the realm is later switched to asymmetric token signing.
PAYMENT_OIDC_JWKS_URI=https://idc.scheuber.io/am/oauth2/realms/root/realms/alpha/connect/jwk_uri

# AIC tenant base URL. Reserved for future runtime use — not currently read
# at runtime by payment-api. The provisioner reads the tenant URL from
# config/payment/aic/inputs/tenant.json and authenticates via frodo connection profile.
AIC_TENANT_URL=https://idc.example.local
