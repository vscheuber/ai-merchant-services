# Acme Payments consumer UI (payment-user-web) env variables.
#
# Copy this file to `.env.local` and fill in real values for local dev.

# Auth.js v5 secret — random string used to sign/encrypt session cookies.
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me

# Payment IDP (Acme Payments' `/alpha` realm — consumer-side auth).
PAYMENT_OIDC_ISSUER=https://idc.scheuber.io/am/oauth2/realms/root/realms/alpha
PAYMENT_OIDC_CLIENT_ID=payment-user-web
PAYMENT_OIDC_CLIENT_SECRET=replace-me

# Downstream services.
PAYMENT_API_BASE_URL=http://localhost:3003
