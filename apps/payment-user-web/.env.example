# Acme Payments consumer UI (payment-user-web) env variables — placeholder
# values only.
#
# Copy this file to `.env.local` and fill in real values for local dev. The
# scaffold does not read any of these at runtime — they are declared here so
# the follow-on wiring PRs have a single source of truth for what the app
# will need.

# Payment IDP (Acme Payments' `/alpha` realm — consumer-side auth in the
# follow-on Use Case 1 wiring PR).
PAYMENT_OIDC_ISSUER=https://idc.example.local/am/oauth2/realms/root/realms/alpha
PAYMENT_OIDC_CLIENT_ID=replace-me
PAYMENT_OIDC_CLIENT_SECRET=replace-me

# Downstream services this app will call in follow-on PRs (not the scaffold).
PAYMENT_API_BASE_URL=http://localhost:3003
