# AIC provisioner env variables.
#
# Copy this file to `.env` (or export variables in your shell) before running
# `pnpm provision` or `pnpm provision --dry-run`.

# ── AIC credentials ──────────────────────────────────────────────────────────
#
# The provisioner reads credentials from a frodo connection profile stored in
# ~/.frodo/Connections.json — no env vars are required for authentication.
# Run `frodo conn save https://openam-volker-dev.forgeblocks.com/am` once to
# create or refresh the profile (frodo will prompt for a service account JWK).

# ── Bravo user credentials ───────────────────────────────────────────────────

# Initial password assigned to all three demo bravo users on creation.
# If unset, the provisioner falls back to a built-in default and logs a warning.
# Set this value to keep credentials out of source.
BRAVO_USER_DEFAULT_PASSWORD=replace-me

# ── OAuth2 client secrets ────────────────────────────────────────────────────
#
# When set, the provisioner injects these as the client secret
# (coreOAuth2ClientConfig.userpassword) on each create/update.
# The same values must be used in the corresponding app .env.local files.
# Generate with: openssl rand -hex 24
OAUTH2_SECRET_PAYMENT_USER_WEB=replace-me
OAUTH2_SECRET_PAYMENT_ADMIN_WEB=replace-me
OAUTH2_SECRET_PAYMENT_API=replace-me
OAUTH2_SECRET_CHATBOT_AGENT=replace-me
OAUTH2_SECRET_MERCHANT_WEB=replace-me
