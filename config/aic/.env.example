# AIC provisioner env variables.
#
# Copy this file to `.env` (or export variables in your shell) before running
# `pnpm provision` or `pnpm provision --dry-run`.

# ── AIC service-account credentials ─────────────────────────────────────────

# Service-account ID with admin rights on the AIC tenant.
# The variable name is read from config/aic/inputs/tenant.json
# (adminServiceAccountEnv field — default "AIC_ADMIN_SVC_ACCOUNT_ID").
AIC_ADMIN_SVC_ACCOUNT_ID=replace-me

# Service-account JWK (JSON string) for the service account above.
AIC_ADMIN_SVC_ACCOUNT_KEY=replace-me

# ── Bravo user credentials ───────────────────────────────────────────────────

# Initial password assigned to all three demo bravo users on creation.
# If unset, the provisioner falls back to a built-in default and logs a warning.
# Set this value to keep credentials out of source.
BRAVO_USER_DEFAULT_PASSWORD=replace-me
