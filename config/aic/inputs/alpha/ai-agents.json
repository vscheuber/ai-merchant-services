[
  {
    "_id": "northwind-chatbot-agent",
    "coreOAuth2ClientConfig": {
      "clientType": "Confidential",
      "status": "Active",
      "clientName": ["Northwind Shopping Assistant"],
      "scopes": ["openid", "profile", "email"],
      "redirectionUris": ["https://payments.mytestrun.com/chatbot/api/auth/callback/aic"],
      "refreshTokenLifetime": 604800,
      "accessTokenLifetime": 3600,
      "authorizationCodeLifetime": 120
    },
    "advancedOAuth2ClientConfig": {
      "grantTypes": ["authorization_code", "urn:ietf:params:oauth:grant-type:token-exchange"],
      "isConsentImplied": false,
      "responseTypes": ["code"],
      "tokenEndpointAuthMethod": "client_secret_post"
    },
    "aiAgentIdentityAttributes": {
      "name": "Northwind Shopping Assistant",
      "description": "A shopping assistant for Northwind merchants."
    }
  }
]
