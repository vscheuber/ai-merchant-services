{
  "name": "ai-merchant-services",
  "version": "0.0.0",
  "private": true,
  "description": "Agentic Commerce POC — Phase 1 scaffold: Acme Payments, Northwind Retail, Acme Assist.",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev:start": "sh scripts/dev-start.sh",
    "dev:stop": "sh scripts/dev-stop.sh",
    "dev:status": "sh scripts/dev-status.sh",
    "dev:restart": "sh scripts/dev-restart.sh",
    "caddy:start": "node scripts/caddy-process.mjs start",
    "caddy:status": "node scripts/caddy-process.mjs status",
    "caddy:reload": "node scripts/caddy-process.mjs reload",
    "caddy:stop": "node scripts/caddy-process.mjs stop",
    "merchant:create": "node scripts/create-merchant.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^20.17.10",
    "eslint": "^9.17.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.19.0"
  }
}
